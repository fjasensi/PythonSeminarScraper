# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mode: telegram | discord | multiple
MODE=telegram

# Discount behavior:
# - keyword (default): notify when page contains "descuento"
# - increase_over_threshold: notify when % discount is >= MIN_DISCOUNT_PERCENTAGE and later increases
DISCOUNT_ALERT_MODE=keyword
MIN_DISCOUNT_PERCENTAGE=20
PRICE_ALERT_THRESHOLD=550
CATALOG_URL=https://escueladehumanidades.unir.net/oferta-academica/
CHECK_INTERVAL_SECONDS=3600
REQUEST_DELAY_SECONDS=5
LOG_TIMEZONE=Europe/Madrid

# Required only when MODE is discord or multiple
DISCORD_WEBHOOK_URL=
